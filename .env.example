APP_NAME="Bawaskar ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=debug

# Production must use: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=error,
# SESSION_SECURE_COOKIE=true, and an empty OTP_BYPASS_NUMBERS.
SESSION_SECURE_COOKIE=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bawaskar_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OTP_BYPASS_NUMBERS=9000000003,9000000004
OTP_BYPASS_CODE=123456
OTP_DEBUG_CODE=123456
OTP_RATE_LIMIT_PER_MINUTE=5
CATALOG_CACHE_MINUTES=10
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120
ENFORCE_STOCK_ON_ORDER=true
ADMIN_EXPORT_LIMIT=2000

# --- Firebase phone sign-in ---
# Verifying an ID token needs only the project id; no service account key is
# stored on this server.
FIREBASE_PROJECT_ID=
# Push notifications: log (writes laravel.log only) or fcm
PUSH_DRIVER=log
# Absolute path to the Firebase service-account JSON, outside public_html
FIREBASE_CREDENTIALS=


# --- ICICI Eazypay payment gateway ---
# EAZYPAY_ENCRYPTION_KEY must be exactly 16 characters (AES-128).
EAZYPAY_ENABLED=false
EAZYPAY_MERCHANT_ID=
EAZYPAY_ENCRYPTION_KEY=
EAZYPAY_SUB_MERCHANT_ID=
EAZYPAY_PAYMODE=9
EAZYPAY_RETURN_URL="${APP_URL}/payments/eazypay/callback"
